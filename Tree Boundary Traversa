class Solution:
    
    def isLeaf(self, node):
        return node.left is None and node.right is None
    
    def leftBoundary(self, node, res):
        cur = node.left
        while cur:
            if not self.isLeaf(cur):
                res.append(cur.data)
            if cur.left:
                cur = cur.left
            else:
                cur = cur.right
    
    def rightBoundary(self, node, res):
        cur = node.right
        temp = []
        while cur:
            if not self.isLeaf(cur):
                temp.append(cur.data)
            if cur.right:
                cur = cur.right
            else:
                cur = cur.left
        
        while temp:
            res.append(temp.pop())
    
    def addLeaves(self, node, res):
        if node is None:
            return
        
        if self.isLeaf(node):
            res.append(node.data)
            return
        
        self.addLeaves(node.left, res)
        self.addLeaves(node.right, res)
    
    def boundaryTraversal(self, root):
        res = []
        
        if root is None:
            return res
        
        if not self.isLeaf(root):
            res.append(root.data)
        
        self.leftBoundary(root, res)
        self.addLeaves(root, res)
        self.rightBoundary(root, res)
        
        return res
        
