class Solution:
    def findFloor(self, arr, x):
        left = 0
        right = len(arr) - 1
        ans = -1

        while left <= right:
            mid = (left + right) // 2

            if arr[mid] <= x:
                ans = mid        # possible floor
                left = mid + 1   # last occurrence check
            else:
                right = mid - 1

        return ans
        
