class Solution:
    def findTwoElement(self, arr):
        n = len(arr)
        repeating = -1
        missing = -1
        
        seen = set()
        
        for num in arr:
            if num in seen:
                repeating = num
            else:
                seen.add(num)
        
        for i in range(1, n+1):
            if i not in seen:
                missing = i
                break
                
        return [repeating, missing]
